<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Finder de Leads Multi-Canal</title>
  <style>
    :root {
      --bg: #f4f6fb;
      --card: #ffffff;
      --primary: #5b6cff;
      --primary-dark: #3d4ee3;
      --text: #1f2937;
      --muted: #6b7280;
      --line: #e5e7eb;
      --ok: #0f766e;
      --warn: #b45309;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: Inter, Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.45;
    }

    .wrap {
      max-width: 1000px;
      margin: 24px auto;
      padding: 0 16px;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 20px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
      margin-bottom: 16px;
    }

    h1 {
      margin-top: 0;
      margin-bottom: 8px;
      font-size: 1.8rem;
    }

    p { margin-top: 0; color: var(--muted); }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 12px;
      margin-bottom: 16px;
    }

    label {
      display: block;
      font-size: 0.9rem;
      margin-bottom: 6px;
      color: #374151;
    }

    input, select {
      width: 100%;
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 10px 12px;
      font-size: 0.95rem;
      background: #fff;
    }

    .network-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 8px;
      margin: 12px 0 16px;
    }

    .network-item {
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 10px;
      display: flex;
      align-items: center;
      gap: 8px;
      background: #fafafa;
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    button {
      border: none;
      border-radius: 8px;
      padding: 10px 14px;
      color: #fff;
      background: var(--primary);
      font-weight: 600;
      cursor: pointer;
    }

    button:hover { background: var(--primary-dark); }

    button.secondary {
      background: #374151;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 12px;
      font-size: 0.9rem;
      overflow-x: auto;
      display: block;
    }

    th, td {
      border: 1px solid var(--line);
      padding: 8px;
      text-align: left;
      white-space: nowrap;
    }

    th { background: #f9fafb; }

    .notice {
      margin-top: 10px;
      border-left: 4px solid var(--warn);
      padding: 10px;
      background: #fffbeb;
      color: #78350f;
      font-size: 0.9rem;
    }

    .ok {
      border-left-color: var(--ok);
      background: #ecfdf5;
      color: #065f46;
    }
  </style>
</head>
<body>
  <main class="wrap">
    <section class="card">
      <h1>Finder de Leads Multi-Canal</h1>
      <p>
        Ferramenta para organizar prospecção por nicho e exportar planilha.
        Para operar em TikTok, Instagram, Google, YouTube, X (Twitter), Threads,
        Pinterest, Telegram e Facebook, use integrações oficiais e dados públicos/consentidos.
      </p>

      <div class="grid">
        <div>
          <label for="niche">Nicho</label>
          <input id="niche" placeholder="Ex.: clínicas de estética" />
        </div>
        <div>
          <label for="location">Região</label>
          <input id="location" placeholder="Ex.: São Paulo - SP" />
        </div>
        <div>
          <label for="limit">Quantidade de leads</label>
          <select id="limit">
            <option value="10">10</option>
            <option value="25">25</option>
            <option value="50" selected>50</option>
            <option value="100">100</option>
          </select>
        </div>
      </div>

      <label>Selecionar redes</label>
      <div class="network-grid" id="networkGrid"></div>

      <div class="actions">
        <button id="btnGenerate">Gerar lista de leads</button>
        <button id="btnCsv" class="secondary">Exportar CSV</button>
      </div>

      <div class="notice">
        Esta interface não faz scraping indevido nem quebra termos de uso. Ela prepara o pipeline de prospecção e estrutura da planilha para ingestão por APIs autorizadas.
      </div>
    </section>

    <section class="card">
      <h2 style="margin-top:0">Prévia da planilha</h2>
      <table id="leadTable"></table>
      <div class="notice ok" id="statusMsg">Preencha os filtros e clique em “Gerar lista de leads”.</div>
    </section>
  </main>

  <script>
    const networks = [
      "TikTok", "Instagram", "Google", "YouTube", "X/Twitter",
      "Threads", "Pinterest", "Telegram", "Facebook"
    ];

    const columns = [
      "empresa", "nicho", "regiao", "rede_origem", "nome_contato",
      "telefone", "whatsapp", "email", "site", "perfil_url", "observacoes", "consentimento"
    ];

    const networkGrid = document.getElementById("networkGrid");
    const leadTable = document.getElementById("leadTable");
    const statusMsg = document.getElementById("statusMsg");
    const limitInput = document.getElementById("limit");

    networks.forEach((network, i) => {
      const item = document.createElement("label");
      item.className = "network-item";
      item.innerHTML = `<input type="checkbox" value="${network}" ${i < 3 ? "checked" : ""}/> ${network}`;
      networkGrid.appendChild(item);
    });

    let leadRows = [];

    function getSelectedNetworks() {
      return [...networkGrid.querySelectorAll("input:checked")].map((el) => el.value);
    }

    function randomPhone() {
      const n1 = Math.floor(10000 + Math.random() * 89999);
      const n2 = Math.floor(1000 + Math.random() * 8999);
      return `+55 11 ${n1}-${n2}`;
    }

    function renderTable(rows) {
      if (!rows.length) {
        leadTable.innerHTML = "";
        return;
      }

      const header = `<tr>${columns.map(c => `<th>${c}</th>`).join("")}</tr>`;
      const body = rows.map(row => `<tr>${columns.map(c => `<td>${row[c] || ""}</td>`).join("")}</tr>`).join("");
      leadTable.innerHTML = header + body;
    }

    function toCsv(rows) {
      const esc = (value) => `"${String(value ?? "").replaceAll('"', '""')}"`;
      const lines = [columns.map(esc).join(",")];
      rows.forEach(row => lines.push(columns.map(col => esc(row[col])).join(",")));
      return lines.join("\n");
    }

    function downloadCsv(filename, csv) {
      const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url;
      link.download = filename;
      document.body.appendChild(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
    }

    document.getElementById("btnGenerate").addEventListener("click", () => {
      const niche = document.getElementById("niche").value.trim() || "nicho não informado";
      const location = document.getElementById("location").value.trim() || "região não informada";
      const selected = getSelectedNetworks();
      const limit = Number(limitInput.value);

      if (!selected.length) {
        statusMsg.textContent = "Selecione ao menos uma rede para gerar os leads.";
        statusMsg.className = "notice";
        return;
      }

      leadRows = Array.from({ length: limit }, (_, idx) => {
        const source = selected[idx % selected.length];
        return {
          empresa: `Lead ${idx + 1} - ${niche}`,
          nicho,
          regiao: location,
          rede_origem: source,
          nome_contato: `Responsável ${idx + 1}`,
          telefone: randomPhone(),
          whatsapp: randomPhone(),
          email: `contato${idx + 1}@exemplo.com`,
          site: "https://empresa-exemplo.com",
          perfil_url: "https://rede-social.com/perfil",
          observacoes: "Validar por API oficial da plataforma.",
          consentimento: "pendente"
        };
      });

      renderTable(leadRows);
      statusMsg.textContent = `Planilha preparada com ${leadRows.length} leads para ${selected.join(", ")}.`;
      statusMsg.className = "notice ok";
    });

    document.getElementById("btnCsv").addEventListener("click", () => {
      if (!leadRows.length) {
        statusMsg.textContent = "Nenhum dado para exportar. Gere os leads primeiro.";
        statusMsg.className = "notice";
        return;
      }
      downloadCsv("leads_multicanal.csv", toCsv(leadRows));
      statusMsg.textContent = "CSV exportado com sucesso.";
      statusMsg.className = "notice ok";
    });
  </script>
</body>
</html>
